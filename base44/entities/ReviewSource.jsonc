{
  "name": "ReviewSource",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Agency ID"
    },
    "business_id": {
      "type": "string",
      "description": "Business ID"
    },
    "platform": {
      "type": "string",
      "enum": [
        "google"
      ],
      "description": "Review platform"
    },
    "place_id": {
      "type": "string",
      "description": "Google Place ID"
    },
    "connected_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "default": "disconnected",
      "description": "Connection status"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last sync timestamp"
    },
    "auth_ref": {
      "type": "string",
      "description": "Auth/token reference"
    }
  },
  "required": [
    "agency_id",
    "business_id",
    "platform"
  ]
}