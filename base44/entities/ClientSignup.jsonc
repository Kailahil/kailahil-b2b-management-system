{
  "name": "ClientSignup",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Client business name"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact full name"
    },
    "email": {
      "type": "string",
      "description": "Client email address"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed password"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status from media specialist"
    },
    "approved_by_user_id": {
      "type": "string",
      "description": "Media specialist who approved"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When approved"
    },
    "rejected_reason": {
      "type": "string",
      "description": "Reason for rejection if rejected"
    },
    "synced_to_base44": {
      "type": "boolean",
      "default": false,
      "description": "Whether synced to Base44 User entity"
    }
  },
  "required": [
    "business_name",
    "contact_name",
    "email",
    "password_hash"
  ]
}