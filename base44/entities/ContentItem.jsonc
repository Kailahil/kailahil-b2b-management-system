{
  "name": "ContentItem",
  "type": "object",
  "properties": {
    "agency_id": {
      "type": "string",
      "description": "Agency ID"
    },
    "business_id": {
      "type": "string",
      "description": "Business ID"
    },
    "platform": {
      "type": "string",
      "enum": [
        "tiktok",
        "instagram"
      ],
      "description": "Target platform"
    },
    "type": {
      "type": "string",
      "enum": [
        "reel",
        "post",
        "story",
        "video"
      ],
      "description": "Content type"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "in_progress",
        "awaiting_approval",
        "approved",
        "scheduled",
        "posted"
      ],
      "default": "idea",
      "description": "Content status"
    },
    "publish_at": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled publish time"
    },
    "caption": {
      "type": "string",
      "description": "Post caption"
    },
    "asset_links": {
      "type": "string",
      "description": "Asset URLs or storage refs (JSON string)"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "Creator user ID"
    },
    "assigned_to_user_id": {
      "type": "string",
      "description": "Assigned user ID"
    },
    "client_visible": {
      "type": "boolean",
      "default": true,
      "description": "Whether content is visible to client"
    },
    "client_title": {
      "type": "string",
      "description": "Client-facing title if different from internal"
    },
    "approved_by_client": {
      "type": "boolean",
      "default": false,
      "description": "Whether client has approved"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When client approved"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When content was published"
    },
    "client_feedback": {
      "type": "string",
      "description": "Client feedback or change requests"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail preview URL"
    }
  },
  "required": [
    "agency_id",
    "business_id",
    "platform",
    "type",
    "created_by_user_id"
  ]
}